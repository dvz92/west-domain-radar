# 过期域名雷达 · 配置
# 改完存盘即生效，不需要重启任何服务。

# ---------- 收件 ----------
# 收件人邮箱，多个用英文逗号分隔。留空 = 不发邮件，只落盘报告。
MAIL_TO=

# ---------- 发件（SMTP）----------
# 常见配置（注意：绝大多数邮箱要用「授权码 / 应用专用密码」，不是登录密码）：
#   QQ 邮箱      SMTP_HOST=smtp.qq.com        SMTP_PORT=465  SMTP_SECURITY=ssl
#   163 邮箱     SMTP_HOST=smtp.163.com       SMTP_PORT=465  SMTP_SECURITY=ssl
#   Gmail        SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  SMTP_SECURITY=ssl
#   Outlook      SMTP_HOST=smtp.office365.com SMTP_PORT=587  SMTP_SECURITY=starttls
#   自建/其他    SMTP_PORT=587 SMTP_SECURITY=starttls（或 25 + none）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
# 发件人地址，留空则用 SMTP_USER
SMTP_FROM=

# ---------- 行为 ----------
# 抓取失败时是否也发一封说明邮件（1=发，0=不发）
MAIL_ON_FAILURE=1

# 发件主题前缀
# 时间由 cron 控制；下面这个只是给 run.sh 用的 TZ 兜底
TZ_OVERRIDE=Asia/Shanghai
