# 过期域名雷达 · 配置
# 改完存盘即生效，不需要重启任何服务。
# 也可以直接跑 `wdradar` 用菜单改，不用手编这个文件。

# ══════════════════════════════════════════════════════════════════
#  推送渠道
# ══════════════════════════════════════════════════════════════════
# 按顺序尝试，第一个成功就停 —— 也就是自动失败转移。
# 可选值：wecom dingtalk feishu serverchan pushplus telegram ntfy webhook email
#   ⚠️ 海外 VPS 上 SMTP 经常不通（机房封 25/465/587 出站，或收件方把境外 IP
#      当风险登录拒掉）。所以推荐把 wecom 放在第一位，email 只做兜底。
# 留空 = 按下面"哪些参数填了"自动推断。
NOTIFY_CHANNELS=wecom,email

# 抓取失败时是否也推一条"没取到数据"的说明（1=推，0=不推）
NOTIFY_ON_FAILURE=1

# ---------- 企业微信机器人（最稳，强烈推荐）----------
# 获取：企业微信群 → 右上角「…」→ 群机器人 → 添加 → 复制 Webhook 地址
WECOM_WEBHOOK=

# ---------- 钉钉机器人 ----------
# 群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 Webhook
# 安全设置若选了「加签」，再把密钥填到 DINGTALK_SECRET
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---------- 飞书机器人 ----------
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook
FEISHU_WEBHOOK=

# ---------- Server酱（推到微信）----------
# https://sct.ftqq.com 扫码登录后拿 SendKey
SERVERCHAN_KEY=

# ---------- PushPlus（推到微信）----------
# https://www.pushplus.plus 微信扫码登录后拿 token
PUSHPLUS_TOKEN=

# ---------- Telegram Bot（海外 VPS 很好用）----------
# 1) 找 @BotFather 发 /newbot 拿 token
# 2) 找 @userinfobot 拿自己的 chat_id（或把 bot 拉进群后取群 id）
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---------- ntfy（可自建，不用注册）----------
# 手机装 ntfy App 订阅一个别人猜不到的 topic 名即可
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---------- 自定义 Webhook（POST JSON：title/content/source/date）----------
CUSTOM_WEBHOOK=

# ══════════════════════════════════════════════════════════════════
#  邮件（SMTP）—— 作为兜底渠道
# ══════════════════════════════════════════════════════════════════
# 常见配置（注意：绝大多数邮箱要用「授权码 / 应用专用密码」，不是登录密码）：
#   QQ 邮箱      smtp.qq.com        465  ssl
#   163 邮箱     smtp.163.com       465  ssl
#   Gmail        smtp.gmail.com     465  ssl
#   Outlook      smtp.office365.com 587  starttls
#   海外 VPS 千万别用 25 端口（多数机房封）
MAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ══════════════════════════════════════════════════════════════════
#  其他
# ══════════════════════════════════════════════════════════════════
# 运行脚本用的时区兜底（cron 时间由管理面板按本机时区换算好）
TZ_OVERRIDE=Asia/Shanghai

# 跑脚本用哪个解释器。安装脚本会自动写成绝对路径 ——
# 因为 cron 的 PATH 很干净（通常只有 /usr/bin:/bin），裸写 python3 可能找不到。
PYTHON=
